# Environment variables for Databricks Sword
# Copy this file to .env.local and fill in the values

# Database (Turso)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js v5
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true

# Databricks PAT encryption
# 32-byte AES key for encrypting stored PAT tokens
# Generate with: openssl rand -hex 32
AES_ENCRYPTION_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Panel
# Password for accessing /admin to manage blog and FAQ content
ADMIN_PASSWORD=

# SMTP (for feedback form)
# Required for /feedback form to send emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEEDBACK_TO=

# Development options
# Set to true to bypass OAuth during local testing
# MOCK_AUTH=true

# Databricks CLI Testing (optional)
# Only needed for local development testing with databricks CLI
# These are NOT used by the app - the app stores per-user credentials in the database
# DATABRICKS_HOST=https://dbc-xxxxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi_xxxxxxxx
# DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx

# Optional Groq hints (advisory only)
# Keep disabled unless explicitly testing hints mode
GROQ_HINTS_ENABLED=false

# Coupons (XP reward codes)
# REQUIRED for coupon redemption to work — there are no defaults in source.
# Format: JSON object, e.g. '{"DBSWORD1000":{"xp":1000,"active":true}}'
# Codes, XP values, and active flags can all be rotated via this env var
# without code changes.
# COUPONS_JSON=
GROQ_API_KEY=
# GROQ_HINTS_MODEL=llama-3.1-8b-instant
# GROQ_HINTS_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Field Ops deployment path
# Set to "true" to use Databricks Asset Bundles (recommended for new deployments)
# Default: false (legacy raw-CLI path)
FIELD_OPS_USE_DAB=false
